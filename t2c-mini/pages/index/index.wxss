/* 写页专属样式。页面骨架 / 页头 / dock / cta 等公共样式在 app.wxss。 */

/* 本页没有 scroll-view：除了页头就是一个撑满剩余高度的输入框，
   文字超出后在 textarea 内部滚动，不整页滚。 */
.page {
  display: flex;
  flex-direction: column;
}

.head {
  flex-shrink: 0;
}

/* ---------- 唯一的输入区：白色圆角卡片，对齐小红书文字编辑器 ---------- */

.editor {
  box-sizing: border-box;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 14px;
  padding: 14px;
}

.editor-input {
  box-sizing: border-box;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  width: 100%;
  font-size: 16px;
  line-height: 1.6;
  color: #17171a;
}

.ph {
  color: #b4ada5;
}

.counter {
  flex-shrink: 0;
  align-self: flex-end;
  margin-top: 8px;
  font-size: 11px;
  color: #b4ada5;
}
