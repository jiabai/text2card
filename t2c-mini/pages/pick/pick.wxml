<!--
  全文件铁律：<text> / <view> 的文字内容必须紧贴标签，绝不能另起一行。
  实测（2026-09-23）：节点内容里只要带前后换行空白，Skyline 会把换行渲染成 □，
  并且整个节点改用不含中文字形的字体——中文全变豆腐块，英文毫无异常。
  所以下面所有文字一律写成 <text ...>文字</text>，一个都不换行。
-->
<view class="root">
  <!--
    离屏导出舞台。两条硬约束：
    1. snapshot 必须在 scroll-view 之外，放进去了 takeSnapshot 不回调。
    2. 宽度要跟着 exportSize 走，写死会让非正方形格式多出空白。
  -->
  <view class="export-stage" style="width:{{exportSize}}px;">
    <snapshot id="cardSnap" mode="view">
      <card
        size="{{exportSize}}"
        format="{{format}}"
        content="{{content}}"
        author="{{author}}"
        date="{{date}}"
        style="{{style}}"
      />
    </snapshot>
  </view>

  <view class="step">
    <view class="status-bg" style="height:{{statusBarHeight}}px;"></view>
    <scroll-view class="page" scroll-y>
      <view class="head">
        <view class="nav-row">
          <view id="btnBack" class="back" bind:tap="onBack"><text class="back-text">‹ 上一步</text></view>
          <text class="step-no step-no-inline">02 / 02 — 选</text>
        </view>
        <text class="title">挑一个版式</text>
        <text class="lede">{{lede}}</text>
      </view>

      <view class="preview-card">
        <card
          size="{{previewSize}}"
          format="{{format}}"
          content="{{content}}"
          author="{{author}}"
          date="{{date}}"
          style="{{style}}"
        />
      </view>

      <view class="block">
        <text class="label">格式</text>
        <view class="seg">
          <view
            wx:for="{{formats}}"
            wx:key="key"
            id="fmt-{{item.key}}"
            class="seg-item {{formatIndex === index ? 'seg-on' : ''}}"
            data-index="{{index}}"
            bind:tap="onFormat"
          >
            <text class="seg-text {{formatIndex === index ? 'seg-text-on' : ''}}">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{errorMsg}}" class="block"><text class="meta error">{{errorMsg}}</text></view>

      <view class="tail"></view>
    </scroll-view>

    <!--
      版式托盘（小红书式底部拇指热区）：5 套刚好一屏放下，不需要滚动，
      所以整个托盘可以放心做「按住横滑实时跟刷」，不存在与滚动手势的冲突。
      轻点 chip = 切换；按住左右滑 = 扫过即换预览。出成品图时隐藏，给面板让位。
    -->
    <view
      wx:if="{{!resultPath}}"
      id="styleTray"
      class="tray"
      bind:touchstart="onTrayTouch"
      bind:touchmove="onTrayTouch"
    >
      <view
        wx:for="{{styleChips}}"
        wx:key="index"
        id="style-{{item.index}}"
        class="tray-chip {{styleIndex === index ? 'tray-chip-on' : ''}}"
        style="background-color:{{item.chipBg}};background-image:{{item.chipImage}};"
        data-index="{{item.index}}"
        bind:tap="onStyle"
      >
        <view class="tray-line" style="background-color:{{item.chipInk}};width:56%;"></view>
        <view class="tray-line" style="background-color:{{item.chipInk}};width:34%;opacity:0.5;"></view>
      </view>
    </view>

    <!--
      成品面板与底栏放进同一个 dock，纵向排布。
      分开各自 fixed 会互相压住（而且 Skyline 的 position: fixed 本身就不可靠），
      这样排下来，面板一出现滚动区自动变矮，不用手算偏移量。
    -->
    <view class="dock">
      <view wx:if="{{resultPath}}" class="sheet-panel">
        <view class="result-frame">
          <image class="result-img" src="{{resultPath}}" mode="aspectFit" />
        </view>
        <text class="meta">{{resultInfo}}</text>
        <view id="btnCloseResult" class="mini mini-center" bind:tap="onCloseResult"><text class="mini-text">不合意，回去改</text></view>
      </view>

      <view class="bar">
        <view wx:if="{{resultPath}}" class="action-row">
          <view id="btnSave" class="cta cta-half" bind:tap="onSave"><text class="cta-text">保存到相册</text></view>
          <view id="btnShare" class="cta cta-line cta-half" bind:tap="onShare"><text class="cta-text cta-text-ink">发给好友</text></view>
        </view>
        <view wx:else id="btnExport" class="cta {{busy ? 'cta-off' : ''}}" bind:tap="onExport"><text class="cta-text {{busy ? 'cta-text-off' : ''}}">{{exportLabel}}</text></view>
      </view>
    </view>
  </view>
</view>
