<view
  class="card"
  style="width:{{s.w}}px;height:{{s.h}}px;padding:{{s.pad}}px;background-color:{{s.bgColor}};background-image:{{s.bgImage}};border-width:{{s.borderW}}px;border-color:{{s.borderColor}};color:{{s.textColor}};"
>
  <!-- 装饰层 1：杂志风格的右上角橙色光斑（w-32 h-32 blur-3xl mix-blend-multiply） -->
  <view
    wx:if="{{s.decor === 'blob'}}"
    class="decor-blob"
    style="width:{{s.decorSize}}px;height:{{s.decorSize}}px;top:{{s.decorOffset}}px;right:{{s.decorOffset}}px;background-color:{{s.decorBlobColor}};"
  ></view>

  <!-- 装饰层 2：光韵风格的整幅 10% 白叠加（bg-white/10 backdrop-blur-[1px]） -->
  <view wx:if="{{s.decor === 'veil'}}" class="decor-veil"></view>

  <!-- 头部：日期 + 风格专属小装饰 -->
  <view class="head" style="margin-bottom:{{s.headGap}}px;">
    <view
      class="date"
      style="font-family:{{s.dateFont}};font-size:{{s.dateSize}}px;color:{{s.dateColor}};letter-spacing:{{s.dateTracking}}em;opacity:{{s.dateOpacity}};"
    >{{dateText}}</view>

    <!-- 极简：32×32 细圆环，描边用当前文字色、透明 20% -->
    <view
      wx:if="{{s.decor === 'ring'}}"
      class="decor-ring"
      style="width:{{s.decorSize}}px;height:{{s.decorSize}}px;border-width:{{s.decorRingW}}px;"
    ></view>

    <!-- 午夜：8×8 亮绿圆点 -->
    <view
      wx:if="{{s.decor === 'dot'}}"
      class="decor-dot"
      style="width:{{s.decorSize}}px;height:{{s.decorSize}}px;"
    ></view>
  </view>

  <!--
    正文：垂直居中，逐 token 断行以避免英文被从中间断开。
    token 有两种：整个英文单词（gap=1 表示后面原本有空格）、单个 CJK 字符（gap=0）。
    词间距只能靠 margin-right 补 —— 逐词 inline-block 会把空格吃掉。
  -->
  <view class="body">
    <view
      class="text"
      style="font-family:{{s.textFont}};font-size:{{s.textSize}}px;font-weight:{{s.textWeight}};font-style:{{s.textItalic}};line-height:{{s.textLH}}px;letter-spacing:{{s.textTracking}}em;"
    >
      <view
        wx:for="{{lines}}"
        wx:for-item="line"
        wx:for-index="li"
        wx:key="i"
        class="line"
      >
        <text
          wx:for="{{line.tokens}}"
          wx:for-item="tk"
          wx:for-index="ti"
          wx:key="i"
          class="word"
          style="margin-right:{{tk.gap ? s.wordGap : 0}}em;"
        >{{tk.t}}</text>
      </view>
    </view>
  </view>

  <!-- 底部：只剩右下角固定水印 -->
  <view class="foot" style="margin-top:{{s.footGap}}px;">
    <view
      class="mark"
      style="font-family:{{s.markFont}};font-size:{{s.markSize}}px;letter-spacing:{{s.markTracking}}em;color:{{s.markColor}};opacity:{{s.markOpacity}};"
    >{{markText}}</view>
  </view>
</view>
